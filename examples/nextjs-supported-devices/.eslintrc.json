{
  "root": true,
  "extends": [
    "standard",
    "standard-jsx",
    "standard-react",
    "plugin:react/jsx-runtime",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "rules": { "react/prop-types": "off" }
}
